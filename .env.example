# ============================================================================
# frameweb 플러그인 환경변수 (.env.example)
# ----------------------------------------------------------------------------
# 이 파일은 "어떤 값을 채워야 하는지" 알려주는 템플릿이다. 실제 값은 넣지 않는다.
#
#   1) 이 파일을 .env 로 복사한다:   cp .env.example .env
#   2) .env 의 빈 항목(특히 비밀번호)을 자기 환경 값으로 채운다.
#   3) 스킬을 쓰기 전에 셸에 로드한다:  set -a; . .env; set +a
#      → 스킬 예시 명령 안의 ${FRAMEWEB_DB_PASSWORD} 같은 자리가 실제 값으로 채워진다.
#
# .env(실제 값)는 .gitignore 로 저장소에 올라가지 않는다. 이 .env.example 만 공개된다.
# 아래 좌표 예시값(host/port/user/name/url)은 Epic Cloud 로컬 개발 표준값이라
# 공개돼도 외부 접근이 불가능하다. 비밀번호 두 개만 빈칸으로 두었다.
#
# 스킬별로 필요한 값이 다르다:
#   · DB 접속이 필요 없는 스킬(frameweb-state / frameweb-require)은 .env 없이도 동작한다.
#   · DB 조회·저장을 하는 스킬(binding / bindchain / canvas / load / analyze / menu /
#     multilanguage / deploy)은 아래 시스템 DB 값이 필요하다.
#   · 화면 확인·로그인이 필요한 스킬(verify / user-manual / drawio)은 앱/로그인 값이 필요하다.
# ============================================================================


# --- 시스템 DB (폼 정의가 저장된 PostgreSQL) --------------------------------
# 폼의 컴포넌트·바인딩·상태 규칙 같은 메타데이터가 이 DB에 들어 있다.
# 스킬은 psql 또는 psycopg2 로 이 좌표에 접속해 폼 정의를 읽고 쓴다.
# (비즈니스별 DB는 스킬이 이 시스템 DB의 bisdb 목록에서 자동으로 찾아가므로
#  여기에 따로 지정하지 않는다.)

# DB 서버 주소. 로컬 개발은 localhost. 예시 명령의 `psql -h ${FRAMEWEB_DB_HOST}` 에 쓰인다.
FRAMEWEB_DB_HOST=localhost

# DB 포트. Epic Cloud 로컬 개발 표준 포트는 5454. `psql -p ${FRAMEWEB_DB_PORT}` 에 쓰인다.
FRAMEWEB_DB_PORT=5454

# DB 접속 사용자명. `psql -U ${FRAMEWEB_DB_USER}` 에 쓰인다.
FRAMEWEB_DB_USER=epicuser

# DB 비밀번호. 【필수 입력 · 공개 저장소에 절대 넣지 말 것】
# psql 은 `PGPASSWORD=${FRAMEWEB_DB_PASSWORD}` 환경변수로 이 값을 읽는다.
FRAMEWEB_DB_PASSWORD=

# 시스템 DB 이름(폼 정의 저장소). `psql -d ${FRAMEWEB_DB_NAME}` 에 쓰인다.
FRAMEWEB_DB_NAME=epicdb_core


# --- 앱 / 로그인 (화면 확인·API 호출용) -------------------------------------
# 만든 폼을 실제 화면에서 확인하거나(frameweb-verify), 로그인 토큰을 발급받아
# API 를 호출할 때(frameweb-user-manual) 쓰인다.

# 프론트엔드 주소. 폼 미리보기 URL 조립에 쓰인다.
# 예: ${FRAMEWEB_APP_URL}/erp/form/{폼ID}?bis_id={비즈니스ID}
FRAMEWEB_APP_URL=http://localhost:5151

# 로그인 계정. ERP(엔드유저) 화면은 admin, 개발자(Dev) 화면은 dao 를 쓴다.
FRAMEWEB_LOGIN_USER=admin

# 로그인 비밀번호. 【필수 입력 · 공개 저장소에 절대 넣지 말 것】
FRAMEWEB_LOGIN_PW=
