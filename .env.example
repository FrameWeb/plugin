# frameweb 스킬이 참조하는 로컬 개발 환경 값.
# 이 파일을 .env 로 복사해 값을 채운다. .env 는 git 에 올리지 않는다(.gitignore).
#
# 민감정보(DB 비밀번호·로그인 비밀번호)는 스킬 본문에 넣지 않고 아래 변수로 참조한다.
# 스킬 사용 전 `set -a; . .env; set +a` 로 로드하면 예시 명령의 ${...} 가 채워진다.
#
# 첫 샘플 frameweb-state 자체는 민감값을 쓰지 않는다.
# 아래 변수는 DB/로그인 접속이 필요한 다른 폼 스킬(frameweb-binding 등)을 확장할 때 사용한다.

# --- 시스템 DB (로컬 개발) ---
FRAMEWEB_DB_HOST=localhost
FRAMEWEB_DB_PORT=5454
FRAMEWEB_DB_USER=epicuser
FRAMEWEB_DB_PASSWORD=
FRAMEWEB_DB_NAME=epicdb_core

# --- 앱 / 로그인 (로컬 개발) ---
FRAMEWEB_APP_URL=http://localhost:5151
FRAMEWEB_LOGIN_USER=admin
FRAMEWEB_LOGIN_PW=
